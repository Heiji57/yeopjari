<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- TODO(SDK 승인 후): Pleos Vehicle / NaviHelper 권한을 문서의 이름 그대로 추가.
         Virtual Console 에서 쓰는 도메인: Motion(기어·브레이크), Convenience(깜빡이·전조등), Safety(경고등). -->

    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
